# --- Mobile (optional sync layer; the app is offline-first without these) ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# EAS project id (set after `eas init`), enables the EAS Update URL
EAS_PROJECT_ID=
EXPO_OWNER=

# --- Studio (server-side only; never expose the service role key to clients) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional basic auth for the studio, "user:password"
STUDIO_BASIC_AUTH=
