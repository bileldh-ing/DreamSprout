{
  "name": "@dreamsprout/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "expo export -p web --output-dir dist",
    "serve:web": "npx serve dist --single -l 8081",
